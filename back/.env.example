# Supabase - use a Connection string no formato URI.
# Para o Render, prefira Connect > Session pooler (porta 5432).
# Nunca deixe o placeholder abaixo em produção.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA_DO_BANCO@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_SSL=true

# Autenticação da aplicação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
AUTH_USER=admin@exemplo.com
AUTH_PASSWORD=troque-por-uma-senha-forte

# O Render define PORT automaticamente. Este valor é apenas para executar localmente.
PORT=3000
NODE_ENV=production

# Opcionais
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
